{
  "info": {
    "name": "ResearchHub Lab4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health ready",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health/ready",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "ready"
          ]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"password\": \"lab4-demo-password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "token"
          ]
        }
      }
    },
    {
      "name": "GET projects",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects?page=1&pageSize=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "POST project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman project\",\n  \"description\": \"Lab4\",\n  \"ownerId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects"
          ]
        }
      }
    },
    {
      "name": "PATCH task status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"InProgress\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks/4/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "4",
            "status"
          ]
        }
      }
    }
  ]
}
